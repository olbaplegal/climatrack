# =====================================================
# CLIMATRACK - VARIÁVEIS DE AMBIENTE
# Copie este arquivo para ".env" e preencha.
# =====================================================

# Porta HTTP do painel/API
PORT=3000

# Segredo usado para assinar o login (JWT). Troque por um texto longo e aleatório.
JWT_SECRET=troque-por-um-segredo-longo

# ---------- Banco de dados (PostgreSQL) ----------
# Local (docker compose):
DATABASE_URL=postgres://climatrack:climatrack@localhost:5432/climatrack
DATABASE_SSL=false
# Supabase (Connect > Session pooler), exemplo:
# DATABASE_URL=postgresql://postgres.xxxxxxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# DATABASE_SSL=true

# ---------- Broker MQTT ----------
# Local (docker compose, sem TLS):
MQTT_URL=mqtt://localhost:1883
MQTT_USER=
MQTT_PASSWORD=
# HiveMQ Cloud (TLS na porta 8883), exemplo:
# MQTT_URL=mqtts://xxxxxxxx.s1.eu.hivemq.cloud:8883
# MQTT_USER=backend
# MQTT_PASSWORD=SenhaForteBackend123

# Prefixo dos tópicos (clima/<device>/dados | status | comando)
MQTT_TOPIC_PREFIX=clima

# ---------- Telegram ----------
# Token do bot criado no @BotFather (deixe vazio para desativar)
TELEGRAM_BOT_TOKEN=
# Chat padrão para alertas de dispositivos sem dono ou dono sem chat cadastrado (opcional)
TELEGRAM_CHAT_ID_PADRAO=
# Responde a comandos /start, /status, /led_on, /led_off no Telegram
TELEGRAM_POLLING=true

# ---------- Regras ----------
# Histerese: o alerta só "normaliza" quando o valor volta X unidades para dentro do limite
HISTERESE=0.5
# Minutos sem dados para considerar o dispositivo inativo no painel
MINUTOS_INATIVO=2
# Segundos que o dispositivo pode ficar offline antes de gerar alerta (evita alarme falso em quedas rápidas de Wi-Fi)
OFFLINE_TOLERANCIA_S=60

# ---------- Nuvem ----------
# ID fixo do cliente MQTT (deixe vazio no ambiente local; no Render use climatrack-backend-render).
# Com ID fixo o broker só aceita UMA instância do back-end e guarda a sessão durante reinícios.
MQTT_CLIENT_ID=
# Apaga leituras com mais de N dias (cota de 500 MB do Supabase Free). 0 = nunca apagar
RETENCAO_DIAS=90
